*.log
*.log.*.gz
*.ovpn

# Python build/test artifacts and local virtualenv.
# venv and pytest write their own self-ignoring .gitignore into these dirs, so
# they stayed out of git without being listed here. Listing them explicitly
# means they stay ignored even when recreated by something that does not.
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# VPN runtime logs and state
vpn_logs/

# qBittorrent runtime state (not a template — regenerated at runtime)
qBittorrent-data.conf

# Backup and temporary files (outside repo, listed for reference only)
# ~/.vpn_backups/ — iptables/DNS backups, never in the repo

# Secrets. The .tmp.* pattern covers start_web.sh's atomic rewrite of .env —
# a bare '.env' rule does not match '.env.tmp.aBc123', and that temp file
# holds the API token.
.env
.env.tmp.*

# Claude Code per-machine permission allowlist. Machine-specific by design —
# it was accumulating entries for paths that only exist on one checkout.
# .claude/settings.json (shared project settings) stays tracked.
.claude/settings.local.json
.claude/settings.local.json.tmp.*

# IDE and system files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# qBittorrent logs
qbit.log
checkvpn.log

# File organizer move-job records. Runtime state written by webapp/app.py so a
# move survives a page reload or a web app restart; never a project artefact.
organizer_jobs.json
organizer_jobs.json.tmp
