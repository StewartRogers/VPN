# Copy to .env and fill in — .env is gitignored and loaded automatically on startup.

# API authentication (Bearer token). The API is NEVER served unauthenticated:
# leave this blank and the app generates a token on first start, appends it to
# webapp/.env, and prints it once so you can paste it into the web UI.
#
# The token is what stops CSRF. Without it, any website you visit can POST to
# this app from your browser — it does not need to be on your network — and
# drive endpoints like /api/vpn/stop that tear down the kill switch.
#
# Generate your own instead with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VPN_API_TOKEN=

# Optional: home/ISP IP to monitor against. Can also be passed as a CLI arg.
HOME_IP=

# Optional: interface to bind the Flask server to. Defaults to 0.0.0.0 (all
# interfaces) so other machines on your LAN can reach the UI. Set to 127.0.0.1
# to restrict it to the Pi itself.
BIND_HOST=0.0.0.0

# Optional: port the Flask server listens on. Defaults to 5000.
# If changed, also re-run 'sudo bash ufw_base.sh' so the firewall opens the new port.
PORT=5000

# Optional: comma-separated directories the file organizer may read and move
# files within. Defaults to the invoking user's home directory. Anything
# outside these roots is refused with a 403 — without this the organizer would
# accept any absolute path, including ~/.ssh and /etc.
#   ORGANIZER_ROOTS=/mnt/media,/home/pi/Downloads
ORGANIZER_ROOTS=

# Optional: set to 1 to log every HTTP request. Off by default.
# Note this writes full request URLs, and the SSE log stream carries the API
# token as a query parameter — so access logs will contain your token.
ACCESS_LOG=
